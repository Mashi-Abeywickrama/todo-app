{
  "compilerOptions": {
    /*  File Paths  */
    "rootDir": "./src",
    "outDir": "./dist",

    /*  Language & Environment  */
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node","express"],

    /*  Output Options  */
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    /*  Strictness  */
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /*  Other Settings  */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}